# Copy to .env to override the defaults in compose.yaml. All values are
# local-only dummy settings; there are no real secrets in this project.
POSTGRES_USER=aster
POSTGRES_PASSWORD=aster_local_dev
POSTGRES_DB=aster

# Host ports
WEB_PORT=3000
API_PORT=8000
DB_PORT=5433

# Seed fictional demo accounts on start-up (idempotent; never modifies existing data).
DEMO_MODE=true
